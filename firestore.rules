rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // ---- users/{uid} : public profile ----
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- posts/{postId} : community feed ----
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Owner can edit their own post; anyone signed-in may update ONLY likeCount/commentCount
      // (those are maintained via transactions from toggleLike/addComment), author/content stay immutable for non-owners.
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- comments/{commentId} ----
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- likes/{uid_targetId} : one doc per (user, post|idea) ----
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.targetId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- saved/{uid_ideaId} : per-user saved date-ideas, private ----
    match /saved/{savedId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && savedId == request.auth.uid + '_' + request.resource.data.ideaId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- notifications/{notifId} : per-recipient, private ----
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Any signed-in user may create a notification FOR another user (e.g. commenting on their post)
      allow create: if isSignedIn();
      // Only the recipient may mark as read / delete
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- movies/{movieId} : curated catalog, admin-only writes ----
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- movieSuggestions/{suggestionId} : public "add a movie" goes here for review ----
    match /movieSuggestions/{suggestionId} {
      allow read: if isSignedIn() && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (resource.data.submittedBy == request.auth.uid || isAdmin());
    }

    // ---- admins/{uid} : existence = is admin. Only settable from Firebase Console / CLI. ----
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- coupleInvites/{code} : short pairing code, doc id IS the code (like invites, secret-by-id).
    // Sender creates it pending; the partner (a different signed-in user) accepts it exactly once. ----
    match /coupleInvites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.partnerUid == null;
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && resource.data.senderUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'partnerUid'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.partnerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }

    // ---- couples/{coupleId} : a linked pair + their shared memories subcollection.
    // members is always exactly the 2 uids; only those 2 may read/write. ----
    match /couples/{coupleId} {
      allow read: if isSignedIn() && resource.data.members.hasAny([request.auth.uid]);
      allow create: if isSignedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAny([request.auth.uid]);
      allow update: if isSignedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members;
      allow delete: if isSignedIn() && resource.data.members.hasAny([request.auth.uid]);

      match /memories/{memoryId} {
        function coupleMembers() { return get(/databases/$(database)/documents/couples/$(coupleId)).data.members; }
        allow read: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]);
        allow create: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]);
        allow delete: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]);
      }
    }

    // ---- gameRooms/{code} : realtime multiplayer game rooms. Doc id IS the 6-char room
    // code (same secret-by-id pattern as invites/coupleInvites) — knowing the code is what
    // lets a friend join. Kept permissive on update (any signed-in player, not just those
    // already listed) since state changes are frequent/varied across many game types and
    // this is casual party-game data, not sensitive — matches how invites/{} is already
    // world-readable. ----
    match /gameRooms/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    // ---- futureLetters/{id} : "Ирээдүйн хосдоо захиа" — private journaling, owner-only. ----
    match /futureLetters/{letterId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- invites/{inviteId} : Урилга feature. Sender must be signed in to create;
    // the doc id itself is the shareable secret (recipient never signs in), so anyone
    // holding the link may read it and write a response exactly once.
    // `data` may also carry these optional sender-authored fields (all written once at
    // create time, never updated afterward — no create-time allowlist restricts them):
    // photos[] (Storage URLs from invites/{senderUid}/... , see storage.rules),
    // music ({trackId,url}|null), theme (string), enabledPages[] (disabled page keys),
    // pageOrder[] (custom order of reorderable page keys). Absent on older docs, which
    // render with the default catalog/order — see js/invite-engine.js. ----
    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.status == 'sent'
        && request.resource.data.response == null;
      allow update: if resource.data.status == 'sent'
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response'])
        && request.resource.data.status == 'responded';
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }
  }
}
