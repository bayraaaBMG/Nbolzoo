rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // The single hardcoded root account. Verified via the Firebase Auth ID token's email
    // claim, which Firebase itself issues/verifies server-side — this is NOT a spoofable
    // frontend-only check. Used ONLY to bootstrap the very first admins/{uid} doc (see
    // below) — every ongoing permission check after that is UID-based via admins/{uid},
    // exactly like any other admin. Keep this string in sync with OWNER_EMAIL in js/auth.js.
    function isOwnerEmail() { return isSignedIn() && request.auth.token.email == 'bbayraaa20@gmail.com'; }
    // A suspended user's own users/{uid} doc has banned==true (set only by an admin, see the
    // users/{uid} update rule below) — blocks new posts/comments at the rules layer, not just
    // by hiding the UI button, so a suspended user can't route around it by calling Firestore directly.
    function isBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == true;
    }

    // ---- users/{uid} : public profile ----
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      // Admins may edit any profile (moderation) EXCEPT they may never ban/suspend the root
      // owner account — protects it from being blocked by a compromised or careless admin.
      allow update: if isOwner(uid) || (isAdmin() &&
        !(resource.data.email == 'bbayraaa20@gmail.com' && request.resource.data.banned == true));
      allow delete: if isAdmin() && resource.data.email != 'bbayraaa20@gmail.com';
    }

    // ---- posts/{postId} : community feed ----
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned() && request.resource.data.authorId == request.auth.uid;
      // Owner can edit their own post; admin may additionally toggle moderation state (hidden);
      // anyone signed-in may update ONLY likeCount/commentCount (maintained via transactions
      // from toggleLike/addComment) — author/content/hidden stay immutable for non-owner non-admins.
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- comments/{commentId} ----
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned() && request.resource.data.authorId == request.auth.uid;
      // Content itself is immutable even for the author (no silent edits) — only an admin may
      // toggle the `hidden` moderation flag, and ONLY that field.
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']);
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- likes/{uid_targetId} : one doc per (user, post|idea) ----
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.targetId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- saved/{uid_ideaId} : per-user saved date-ideas, private ----
    match /saved/{savedId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && savedId == request.auth.uid + '_' + request.resource.data.ideaId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- notifications/{notifId} : per-recipient, private ----
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Any signed-in user may create a notification FOR another user (e.g. commenting on their post)
      allow create: if isSignedIn();
      // Only the recipient may mark as read / delete
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- movies/{movieId} : curated catalog, admin-only writes ----
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- movieSuggestions/{suggestionId} : public "add a movie" goes here for review ----
    match /movieSuggestions/{suggestionId} {
      allow read: if isSignedIn() && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (resource.data.submittedBy == request.auth.uid || isAdmin());
    }

    // ---- admins/{uid} : existence = is admin. doc shape {email, name, role: 'owner'|'admin',
    // addedBy, addedAt}. Exactly one 'owner' doc may ever exist (the hardcoded root account,
    // self-provisioned on first login via js/auth.js's ensureUserProfile — see isOwnerEmail()
    // above), and it can never be deleted through the app by anyone, including itself — that's
    // what makes it impossible for the root account to be locked out or demoted. Any admin
    // (owner or regular) may grant/revoke a REGULAR admin's rights; only 'admin' role docs
    // (never 'owner') can ever be created via the isAdmin() branch below. ----
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        (request.auth.uid == uid && isOwnerEmail() && request.resource.data.role == 'owner')
        || (isAdmin() && request.resource.data.role == 'admin' && request.resource.data.addedBy == request.auth.uid)
      );
      allow update: if false; // role changes are always delete+recreate, never an in-place edit
      allow delete: if isAdmin() && resource.data.role != 'owner';
    }

    // ---- coupleInvites/{code} : short pairing code, doc id IS the code (like invites, secret-by-id).
    // Sender creates it pending; the partner (a different signed-in user) accepts it exactly once. ----
    match /coupleInvites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.partnerUid == null;
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && resource.data.senderUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'partnerUid'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.partnerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }

    // ---- couples/{coupleId} : a linked pair + their shared memories subcollection.
    // members is always exactly the 2 uids; only those 2 may read/write. ----
    match /couples/{coupleId} {
      allow read: if isSignedIn() && resource.data.members.hasAny([request.auth.uid]);
      allow create: if isSignedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAny([request.auth.uid]);
      allow update: if isSignedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members;
      allow delete: if isSignedIn() && resource.data.members.hasAny([request.auth.uid]);

      match /memories/{memoryId} {
        function coupleMembers() { return get(/databases/$(database)/documents/couples/$(coupleId)).data.members; }
        allow read: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]);
        allow create: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]);
        allow delete: if isSignedIn() && coupleMembers().hasAny([request.auth.uid]);
      }
    }

    // ---- gameRooms/{code} : realtime multiplayer game rooms. Doc id IS the 6-char room
    // code (same secret-by-id pattern as invites/coupleInvites) — knowing the code is what
    // lets a friend join. Kept permissive on update (any signed-in player, not just those
    // already listed) since state changes are frequent/varied across many game types and
    // this is casual party-game data, not sensitive — matches how invites/{} is already
    // world-readable. ----
    match /gameRooms/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    // ---- futureLetters/{id} : "Ирээдүйн хосдоо захиа" — private journaling, owner-only. ----
    match /futureLetters/{letterId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- reports/{reportId} : user-flagged posts/comments, feeding the admin moderation
    // queue. Any signed-in user may file one about someone else's content; only an admin may
    // read/triage/resolve them (reports are moderation-internal, not a public feed). ----
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- adminLog/{logId} : append-only audit trail of admin moderation actions (who did
    // what, when) shown in the dashboard's Activity log. Admin-write, admin-read, never
    // editable/deletable — that's what makes it a trustworthy audit trail. ----
    match /adminLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ---- banners/{bannerId} : admin-only ad/promo banners shown on the home page.
    // No owner concept at all — only an admin may create/update/delete; every signed-in
    // OR anonymous visitor may read (the public site renders active banners with no auth). ----
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- invites/{inviteId} : Урилга feature. Sender must be signed in to create;
    // the doc id itself is the shareable secret (recipient never signs in), so anyone
    // holding the link may read it and write a response exactly once.
    // Besides `type`/`data`, the doc may also carry these optional top-level, sender-authored
    // fields (all written once at create time, never updated afterward — no create-time
    // allowlist restricts them): photos[] ({url,thumbUrl,caption,title,date}, Storage URLs
    // from invites/{senderUid}/... , see storage.rules), music ({id,url,title}|null),
    // theme (string), enabledPages[] (disabled page keys/groups — exclusion list, not an
    // allowlist), pageOrder[] (custom order of the reorderable "bonus" page cluster),
    // persuade (bool — opt-in for the "бодоод үзье..." cat sequence on eligible types).
    // All absent on older docs, which render with the default catalog/order/no-persuade
    // behavior — see js/invite-engine.js + js/invite.js. ----
    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.status == 'sent'
        && request.resource.data.response == null;
      allow update: if resource.data.status == 'sent'
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response'])
        && request.resource.data.status == 'responded';
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }
  }
}
